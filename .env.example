# Copy this file to .env and fill in both values. Never commit .env (it is in .gitignore).
# Generate fresh random values on each machine; these are local demo secrets.
#
# PowerShell:  $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# bash:        openssl rand -base64 48

# JWT signing key shared by auth-service and api-gateway (at least 32 characters)
JWT_SECRET=

# Password for the three Postgres containers and the services that connect to them
POSTGRES_PASSWORD=
